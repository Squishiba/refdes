{% extends "base.html.j2" %}
{% block title %}{{ page.title }} — {{ project.title }}{% endblock %}
{% block content %}

<div class="page-layout">

  {% if page.headings | length > 2 %}
  <aside class="page-toc">
    <h2>On this page</h2>
    <ul>
      {% for level, text, anchor in page.headings %}
      <li class="toc-h{{ level }}"><a href="#{{ anchor }}">{{ text }}</a></li>
      {% endfor %}
    </ul>
  </aside>
  {% endif %}

  <article class="page body">
    {{ page.body_html | safe }}
  </article>

</div>

{% endblock %}
