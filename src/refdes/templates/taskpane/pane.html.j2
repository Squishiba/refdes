{% if pane %}
{# The task pane's markup, one file (W5b.3): item.html.j2 includes this for
   every render that writes bytes, and serve's response decoration re-renders
   this same file with the pane model flagged `interactive` — one spelling of
   the pane, and the tick checkbox exists only in that response. The model
   contract (task_pane.py): `pane` is `pane_for`'s dict; rows carry `tick`
   only when the model is interactive.

   §7a sub-decision 6: the toggle is always reachable (it is fixed to the
   page by taskpane.css); `hidden` until the pane script exists, so with
   JavaScript off neither toggle nor pane ever appears. #}
<button type="button" class="refdes-taskpane-toggle" id="refdes-taskpane-toggle" aria-controls="refdes-taskpane" aria-expanded="false" hidden>Tasks</button>
<aside class="refdes-taskpane" id="refdes-taskpane" data-refdes-taskpane="{{ pane.ref }}" aria-label="Thread tasks" hidden>
  <header class="refdes-taskpane-head">
    <h2 class="refdes-taskpane-title">Tasks <span class="mono">{{ pane.ref }}</span></h2>
    <button type="button" class="refdes-taskpane-close" aria-label="Close task pane">&times;</button>
  </header>
  {% if pane.forked %}
  {# §7a sub-decision 3: one tab per open tip, never a union — the tabs
     are the projection's branches, and each panel shows only its own
     tip's list. #}
  <div class="refdes-taskpane-tabs" role="tablist" aria-label="Open tips">
    {% for tab in pane.tabs %}
    <button type="button" role="tab" class="refdes-taskpane-tab mono" id="refdes-taskpane-tab-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}" aria-controls="refdes-taskpane-panel-{{ loop.index }}" data-refdes-tab="{{ loop.index }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ tab.tip }}</button>
    {% endfor %}
  </div>
  {% endif %}
  {% for tab in pane.tabs %}
  {# The heading is `refdes thread`'s own line, spelled once in threads.py
     and handed to the page in the pane model (`tab.heading`) — the template
     never re-types it (PR #197 review C1). The tab roles are a fork's:
     with no tablist above, a bare `role="tabpanel"` would name a tab that
     does not exist (PR #197 review C2). #}
  <div class="refdes-taskpane-panel"{% if pane.forked %} role="tabpanel" aria-labelledby="refdes-taskpane-tab-{{ loop.index }}"{% endif %} id="refdes-taskpane-panel-{{ loop.index }}" data-refdes-panel="{{ loop.index }}"{% if pane.forked and not loop.first %} hidden{% endif %}>
    {% if tab.note %}
    {# §7a sub-decision 1: the tip's list on an older entry, saying so. #}
    <p class="refdes-taskpane-note small">{{ tab.note }}</p>
    {% endif %}
    <p class="refdes-taskpane-tip small"><span class="mono">{{ tab.tip }}</span>{% if tab.date %} {{ tab.date }}{% endif %}{% if tab.summary %} — {{ tab.summary }}{% endif %}</p>
    {% if tab.verdict %}
    <p class="refdes-taskpane-verdict">{{ tab.verdict }}</p>
    {% endif %}
    {% if tab.tasks.state == 'declared' %}
    {# B1 (PR #197 review): the malformed count rides on the heading and
       the valid rows print under it, exactly as `refdes thread` prints
       them — the count is never the note that stands where the rows go. #}
    <p class="refdes-taskpane-heading">{{ tab.heading }}{% if tab.tasks.malformed_note %} {{ tab.tasks.malformed_note }}{% endif %}</p>
    {# K4 (PR #197 review): no `tight` here on purpose — style.css `ul.tight`
       (element+class) out-specifies this list's class rules, so the pane's
       own spacing would never ship. The pane styles its own list.
       Round-5 nit: when EVERY authored row was malformed there is nothing
       to list — the heading above carries the count and the list itself is
       absent, not empty. #}
    {% if tab.tasks.rows %}
    <ul class="refdes-taskpane-tasks">
      {% for row in tab.tasks.rows %}
      {% if row.tick %}
      {# W5b.3 (plan §4, Q6/Q4): the row's tick — a real checkbox (no inline
         handler; CSP is script-src 'self'), labelled with the row's own
         text, naming its state, its legal target states, and the TIP a
         later save writes against. The row's age line rides inside the
         label, like the read-only row's; the pane module taskpane-ticks.js
         (served with this response only) annotates the list. #}
      <li><span class="mono">{{ loop.index }}.</span> <label class="refdes-taskpane-tick" for="{{ row.tick.id }}"><input type="checkbox" id="{{ row.tick.id }}" data-refdes-task="{{ row.id }}" data-refdes-task-state="{{ row.tick.state }}" data-refdes-tick-states="{{ row.tick.targets }}" data-refdes-tip="{{ row.tick.tip }}"{% if row.tick.checked %} checked{% endif %}> <span class="mono">{{ row.id }}</span> {{ row.text }}{% if row.since %} <span class="small muted">{{ row.since }}</span>{% endif %}</label></li>
      {% else %}
      {# The same facts `refdes thread` prints, the checkbox glyph as text
         — this is the read-only pane; ticking happens in files or /edit/. #}
      <li><span class="mono">{{ loop.index }}.</span> <span class="mono">{{ row.glyph }}</span> <span class="mono">{{ row.id }}</span> {{ row.text }}{% if row.since %} <span class="small muted">{{ row.since }}</span>{% endif %}</li>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
    {% else %}
    <p class="refdes-taskpane-heading">{{ tab.heading }} {{ tab.tasks.posture }}</p>
    {% endif %}
  </div>
  {% endfor %}
  {% if pane.derived %}
  <details class="refdes-taskpane-derived">
    {# §7a sub-decision 4: derived, self-closing rows in a second section
       of the same pane — collapsed by default (no `open`), labelled as
       derived, rows carry no glyph and nothing here writes. #}
    <summary>{{ pane.derived_heading }}</summary>
    {% for group in pane.derived %}
    <h3>{{ group.heading }}</h3>
    {# No `tight` here either (round-6 nit): style.css `ul.tight` would
       out-specify `.refdes-taskpane-derived ul` the same way it out-specifies
       the tasks list above, so the class only half applied. The pane styles
       its own list. #}
    <ul class="small mono">
      {% for row in group.rows %}
      <li>{{ row }}</li>
      {% endfor %}
    </ul>
    {% endfor %}
  </details>
  {% endif %}
</aside>
{% endif %}
