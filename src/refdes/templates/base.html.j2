<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ project.title }}{% endblock %}</title>
<link rel="stylesheet" href="assets/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="{{ home_href }}">{{ project.title }}</a>
  <nav>
    {% macro render_nav_node(node) %}
    {% if node.href %}
    <a href="{{ node.href }}">{{ node.label }}</a>
    {% else %}
    <span class="nav-group">
      <span class="nav-group-label">{{ node.label }}</span>
      {% for child in node.children %}
      {{ render_nav_node(child) }}
      {% endfor %}
    </span>
    {% endif %}
    {% endmacro %}
    {% for node in nav_tree %}
    {{ render_nav_node(node) }}
    {% endfor %}
  </nav>
</header>

<main>
{% block content %}{% endblock %}
</main>

<footer class="footer">
  Generated by Refdes.
  {% if project.items %}The machine-readable source of truth is
  <a href="items.json">items.json</a>.{% endif %}
</footer>

<div id="preview-card" role="tooltip" hidden></div>
<script id="preview-data" type="application/json">{{ previews_json | safe }}</script>
<script src="assets/app.js"></script>
</body>
</html>
