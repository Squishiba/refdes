<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ project.title }}{% endblock %}</title>
<link rel="stylesheet" href="assets/style.css">
{% if theme_css %}<link rel="stylesheet" href="{{ theme_css }}">
{% endif %}
{% if taskpane_assets %}<link rel="stylesheet" href="assets/taskpane.css">
{% endif %}
{% if navis_assets %}<link rel="stylesheet" href="assets/navis.css">
{% endif %}
</head>
<body>
<aside class="sidenav">
  <a class="brand" href="{{ home_href }}">{{ project.title }}</a>
  {# The checkbox hack, not another <details>: below the breakpoint further
     down in style.css this collapses the whole tree behind one "Navigation"
     line, since rendering it open unconditionally would push page content
     down by several hundred pixels on a phone before any of it is visible --
     worse than the wrapped bar this replaces. A <details> wrapper here
     doesn't work for this: closed non-summary content is hidden by an
     internal, unstyleable UA mechanism in current browsers (verified
     directly, not assumed -- a plain `display` override on the content does
     not reach it), so there is no reliable way to force it open at a wider
     viewport with CSS alone. A checkbox's :checked state has no such
     problem. Still no JavaScript: the label alone drives it. #}
  <input type="checkbox" id="sidenav-toggle" class="sidenav-toggle-input">
  <label for="sidenav-toggle" class="sidenav-toggle-label">☰ Navigation</label>
  <nav>
    {% macro render_nav_node(node) %}
    {% if node.href %}
    <a href="{{ node.href }}"{% if node.href == current_page %} aria-current="page"{% endif %}>{{ node.label }}</a>
    {% else %}
    <details{% if node.contains(current_page) %} open{% endif %}>
      <summary>{{ node.label }}</summary>
      {% for child in node.children %}
      {{ render_nav_node(child) }}
      {% endfor %}
    </details>
    {% endif %}
    {% endmacro %}
    {% for node in nav_tree %}
    {{ render_nav_node(node) }}
    {% endfor %}
  </nav>
</aside>

<div class="content">
<main>
{% if draft_build %}
<div class="draft-banner">Draft build — not sealed. Run without --dry-run to seal and publish this site for real.</div>
{% endif %}
{% block content %}{% endblock %}
</main>

<footer class="footer">
  Generated by Refdes.
  {% if project.items %}The machine-readable source of truth is
  <a href="items.json">items.json</a>.{% endif %}
</footer>
</div>

{% if navis_panel %}
{# Navis site panel (slice 4a, design §11): read-only, `<details>`-based
   (no JS, no fetch -- the data rides the page, the task pane's contract),
   stacked above the task pane in the z-order (§11) in the corner it does
   not own. The published site cannot write (PR #396 decision 4): restore
   is shown DISABLED with the CLI command that does act. #}
<details class="refdes-navis">
  <summary class="refdes-navis-toggle">Navis <span class="mono">({{ navis_panel.active | length }})</span></summary>
  <div class="refdes-navis-panel">
    {% if navis_panel.active %}
    <ul class="refdes-navis-list">
      {% for row in navis_panel.active %}
      <li>
        <span class="mono">{{ row.key6 }}</span>
        {% if row.href %}<a href="{{ row.href }}">{{ row.item }}</a>{% endif %}
        {{ row.text }}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="refdes-navis-empty">No active Navis.</p>
    {% endif %}
    {% if navis_panel.archived %}
    <details class="refdes-navis-all" id="refdes-navis-all">
      <summary>Show all ({{ navis_panel.count }})</summary>
      <ul class="refdes-navis-list">
        {% for row in navis_panel.rows %}
        <li>
          <span class="mono">{{ row.key6 }}</span>
          {% if row.href %}<a href="{{ row.href }}">{{ row.item }}</a>{% endif %}
          {% if row.orphan %}<span class="refdes-navis-note">marker not found ({{ row.file }})</span>{% endif %}
          {{ row.text }}
          {% if row.archived %}<span class="refdes-navis-tag">[archived]</span> <button type="button" class="refdes-navis-restore" disabled title="the published site is read-only — run: refdes navis restore {{ row.key6 }}">Restore</button>{% endif %}
          {% if row.changed %}<span class="refdes-navis-note">{{ navis_panel.changed_note }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}
  </div>
</details>
{% endif %}
<div id="preview-card" role="tooltip" hidden></div>
<script id="preview-data" type="application/json">{{ previews_json | safe }}</script>
<script src="assets/app.js"></script>
{% if taskpane_assets %}<script src="assets/taskpane.js" defer></script>
{% endif %}
</body>
</html>
