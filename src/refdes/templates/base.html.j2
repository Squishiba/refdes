<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ project.title }}{% endblock %}</title>
<link rel="stylesheet" href="assets/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="{{ home_href }}">{{ project.title }}</a>
  <nav>
    {% for page in project.pages if page.in_nav %}
    <a href="{{ page.slug }}.html">{{ page.title }}</a>
    {% endfor %}
    {% if project.items %}
    <a href="summary.html">Summary</a>
    <a href="{{ dashboard_href }}">Items</a>
    <a href="coverage.html">Coverage</a>
    {% if has_log %}<a href="log.html">Design log</a>{% endif %}
    <a href="document.html">Full record</a>
    <a href="items.json">JSON</a>
    {% endif %}
  </nav>
</header>

<main>
{% block content %}{% endblock %}
</main>

<footer class="footer">
  Generated by Refdes.
  {% if project.items %}The machine-readable source of truth is
  <a href="items.json">items.json</a>.{% endif %}
</footer>

<div id="preview-card" role="tooltip" hidden></div>
<script id="preview-data" type="application/json">{{ previews_json | safe }}</script>
<script src="assets/app.js"></script>
</body>
</html>
