{
  "name": "refdes",
  "displayName": "Refdes",
  "description": "Hardware design reference documentation: live diagnostics, ID completion, and inline calc results.",
  "version": "0.1.0",
  "publisher": "SquishingCo",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters", "Other"],
  "keywords": [
    "hardware",
    "requirements",
    "traceability",
    "electronics",
    "engineering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Squishiba/refdes.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Squishiba/refdes/tree/main/editors/vscode",
  "bugs": { "url": "https://github.com/Squishiba/refdes/issues" },
  "galleryBanner": { "color": "#14171A", "theme": "dark" },
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:**/refdes-project.yaml"],
  "extensionDependencies": ["redhat.vscode-yaml"],
  "contributes": {
    "commands": [
      { "command": "refdes.build", "title": "Refdes: Build site", "icon": "$(play)" },
      { "command": "refdes.check", "title": "Refdes: Check" },
      { "command": "refdes.allocateIds", "title": "Refdes: Allocate missing IDs" },
      { "command": "refdes.openPreview", "title": "Refdes: Open built site", "icon": "$(preview)" },
      { "command": "refdes.refreshIndex", "title": "Refdes: Refresh index" },
      { "command": "refdes.toggleCalcResults", "title": "Refdes: Toggle inline calc results" },
      { "command": "refdes.attachServer", "title": "Refdes: Attach to running server" },
      { "command": "refdes.openInEditor", "title": "Refdes: Open in editor" },
      { "command": "refdes.showServerLog", "title": "Refdes: Show server log" },
      { "command": "refdes.navisArchive", "title": "Refdes: Archive Navi", "icon": "$(archive)" },
      { "command": "refdes.navisRestore", "title": "Refdes: Restore Navi", "icon": "$(restore)" },
      { "command": "refdes.navisMint", "title": "Refdes: Mint keys", "icon": "$(key)" },
      { "command": "refdes.refreshNavis", "title": "Refdes: Refresh Navis" },
      { "command": "refdes.navisOpenInEditor", "title": "Refdes: Navis: Open in editor", "icon": "$(globe)" }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "refdes.openInEditor",
          "when": "false"
        },
        {
          "command": "refdes.navisArchive",
          "when": "false"
        },
        {
          "command": "refdes.navisRestore",
          "when": "false"
        },
        {
          "command": "refdes.navisMint",
          "when": "refdes.active"
        },
        {
          "command": "refdes.navisOpenInEditor",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "refdes.navisArchive",
          "when": "view == refdes.navisTree && viewItem =~ /(^| )refdesNavi( |$)/ && !(viewItem =~ /refdesNaviArchived/) && !(viewItem =~ /refdesNaviKeyless/)",
          "group": "1_navisWrite@1"
        },
        {
          "command": "refdes.navisRestore",
          "when": "view == refdes.navisTree && (viewItem =~ /refdesNaviArchived/) && !(viewItem =~ /refdesNaviKeyless/)",
          "group": "1_navisWrite@2"
        },
        {
          "command": "refdes.navisMint",
          "when": "view == refdes.navisTree && (viewItem =~ /refdesNaviKeyless/)",
          "group": "2_navisMint"
        },
        {
          "command": "refdes.navisOpenInEditor",
          "when": "view == refdes.navisTree && viewItem =~ /(^| )refdesNavi( |$)/ && !(viewItem =~ /refdesNaviKeyless/)",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "refdes.navisMint",
          "when": "view == refdes.navisTree",
          "group": "navigation",
          "icon": "$(key)"
        }
      ],
      "editor/title": [
        {
          "command": "refdes.build",
          "when": "resourceExtname =~ /\\.(md|yaml|yml)$/ && refdes.active",
          "group": "navigation@1"
        },
        {
          "command": "refdes.openPreview",
          "when": "resourceExtname =~ /\\.(md|yaml|yml)$/ && refdes.active",
          "group": "navigation@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "refdes.navisTree",
          "name": "Refdes Navis",
          "when": "refdes.active",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Refdes",
      "properties": {
        "refdes.command": {
          "type": "string",
          "default": "refdes",
          "description": "Command used to run Refdes. Use e.g. '.venv/Scripts/python.exe -m refdes.cli' if it is not on your PATH."
        },
        "refdes.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-index and publish diagnostics when a file is saved."
        },
        "refdes.showCalcResults": {
          "type": "boolean",
          "default": true,
          "description": "Show evaluated calc results inline at the end of each line."
        },
        "refdes.docsContext.url": {
          "type": "string",
          "default": "",
          "description": "URL of a running docs-context viewer to follow the cursor (POST <url>/api/focus with the workspace-relative path and 1-based line of the active editor — never file contents). Loopback only (127.0.0.1, localhost, ::1); any other host is ignored. Empty (the default) posts nothing."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "markdown.refdes.calc",
        "path": "./syntaxes/calc.injection.json",
        "injectTo": ["text.html.markdown", "source.yaml"]
      }
    ],
    "problemMatchers": [
      {
        "name": "refdes",
        "owner": "refdes",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(ERROR|WARNING)\\s+(\\S+?):(\\d+)(?:\\s+\\[[^\\]]+\\])?\\s+—\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      }
    ]
  }
}
