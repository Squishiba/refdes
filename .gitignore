_site/
*.egg-info/
build/
dist/
_docs/

# Per-machine Claude Code permissions, not shared state.
.claude/settings.local.json
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Build outputs of the VS Code extension. The .vsix is regenerated by
# `npx @vscode/vsce package`; the Marketplace is where releases live.
*.vsix
node_modules/

# Not ignored on purpose: .refdes/ids.yaml is the ID ledger, and
# .refdes/citations.yaml is the citation lockfile (sha256 + fetch time, no
# bytes) -- both record which numbers/hashes have been burned and must be
# committed, or two branches will hand out the same ID or re-pin a datasheet
# without anyone noticing. The kept bytes themselves are a different
# matter: manufacturer datasheets are generally copyrighted, so the actual
# PDFs `refdes fetch` downloads with `keep_copy: true` are gitignored and
# re-fetched locally instead of committed.
.refdes/copies/

# .refdes/schema.json is regenerated on every command that loads the
# project -- deleting it loses nothing, and a committed copy would just be
# one more thing that can silently disagree with the project config. **/ so
# this also covers docs-site/.refdes/, a second refdes project living in
# this same repo.
**/.refdes/schema.json

# A scratch refdes project used to exercise doc generation against a real
# schema. It has its own project config and is not part of this tool -- kept
# on disk, deliberately out of the repo.
ornith-docs/

# Per-worktree scratch area for temporary files created by agents or by
# hand -- scratch scripts, throwaway test projects, probe output. Nothing
# here is ever committed, and nothing in it needs cleaning up.
.scratch/
